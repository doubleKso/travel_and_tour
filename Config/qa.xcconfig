// Build settings for the qa flavor — mirrors ios/Flutter/qaRelease.xcconfig.
// Selected by the EpicWorld-qa scheme (Debug-qa / Release-qa).

APP_FLAVOR = qa
BUNDLE_DISPLAY_NAME = Epic World QA
PRODUCT_BUNDLE_IDENTIFIER = com.systematic.epicWorld.qa
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-qa

// Google Sign-In callback scheme — must match REVERSED_CLIENT_ID in
// Config/Firebase/qa/GoogleService-Info.plist.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.75564183650-mtf80v9f1ge4e5dui2jo64kkpelnqb55
